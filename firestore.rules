rules_version = '2';

// Private dashboard: only accounts listed in /allowed/{uid} can use it,
// and each account only touches its own /users/{uid} subtree.
// The allowlist document is created by hand in the Firebase console, so no
// e-mail or UID ever needs to be committed to this repository.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/allowed/$(request.auth.uid));
    }

    function validEntry() {
      let d = request.resource.data;
      return d.type in ['income', 'expense']
        && d.amount is number && d.amount >= 0
        && d.description is string && d.description.size() <= 200
        && d.categoryId is string;
    }

    match /allowed/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      match /transactions/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEntry() && request.resource.data.date is string;
      }
      match /recurring/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEntry()
          && request.resource.data.dayOfMonth is int
          && request.resource.data.dayOfMonth >= 1 && request.resource.data.dayOfMonth <= 31;
      }
      match /categories/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      }
    }
  }
}
