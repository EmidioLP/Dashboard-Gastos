# Copie para .env.local e preencha com a config do seu app Web
# (Console do Firebase → Configurações do projeto → Seus apps → SDK setup and configuration).
# .env.local é ignorado pelo Git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = usa os emuladores locais (npm run emulators) em vez do projeto real
VITE_USE_EMULATORS=false
